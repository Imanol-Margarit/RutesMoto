PORT=3001
CORS_ORIGIN=http://localhost:4200

# Groq: crea la clave gratis en https://console.groq.com/keys (empieza por gsk_)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# API principal de Moto Routes (los endpoints públicos /shop)
MOTO_ROUTES_API_URL=http://localhost:3000/api

# Tiempo máximo de cada llamada externa (ms)
HTTP_TIMEOUT_MS=15000
